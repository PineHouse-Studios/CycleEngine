{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cycle Dialog Script",
  "scopeName": "source.cds",
  "patterns": [
    { "match": "^\\s*(\\[)(\\d{4}:\\d+:\\d+)(\\])", "captures": { "1": { "name": "punctuation.definition.section.begin.cds" }, "2": { "name": "entity.name.section.cds" }, "3": { "name": "punctuation.definition.section.end.cds" } } },
    { "match": "^\\s*(title|text)(\\s*=)", "captures": { "1": { "name": "support.type.property-name.cds" }, "2": { "name": "keyword.operator.assignment.cds" } } },
    { "match": "^\\s*(-)\\s+", "captures": { "1": { "name": "keyword.operator.choice.cds" } } },
    { "match": "#.*$", "name": "comment.line.number-sign.cds" }
  ]
}
