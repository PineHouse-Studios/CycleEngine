{
  "name": "cycle-dialog-script",
  "displayName": "Cycle Dialog Script",
  "description": "VS Code support for .cds dialogue files",
  "version": "0.1.8",
  "publisher": "cycle-engine",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:cds"],
  "main": "./extension.js",
  "scripts": {
    "build-server": "dotnet publish .. -c Release -o server",
    "vscode:prepublish": "npm run build-server"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [{
      "id": "cds",
      "aliases": ["Cycle Dialog Script", "CDS"],
      "extensions": [".cds"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "cds",
      "scopeName": "source.cds",
      "path": "./syntaxes/cds.tmLanguage.json"
    }],
    "configurationDefaults": {
      "[cds]": {
        "editor.inlineSuggest.enabled": false,
        "editor.suggest.preview": false,
        "editor.quickSuggestions": {
          "comments": "off",
          "strings": "off",
          "other": "on"
        }
      }
    }
  }
}
