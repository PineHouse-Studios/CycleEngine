title = "Prologue"

[begin script]

[begin onload]
@function ChptWhiteStart(chptstart, bg0, bg1)
@loadscene [0000:1]
[end onload]

[begin 0000:1]

[0000:1:1]
@music play MySong prog=0
@bg update bg1 x.velocity=2 dur=3000
@wait 1000
@bg show bg1 x=0 x.velocity=0 zoom=100 dur=1000
@image create bob content=bob, x=-100, show
@audio play $sys.lang$_bob_0000_1_1
@dialog [0000:1:1]

[0000:1:2]
@image update bob content=bob.smile x=0 dur=1000 ease=oquart
@audio play $sys.lang$_bob_0000_1_2
@dialog [0000:1:2]
@wait sys.lang ?? {"zh"= 50, "jp"= 100}
@image update alice content:alice.bored

[0000:1:3]
@audio play $sys.lang$_kevin_0000_1_3
@dialog [0000:1:3]

[0000:1:4]
@audio play $sys.lang$_bob_0000_1_4
@camera shake
@image update bob ani:laugh
@dialog [0000:1:4]

[0000:1:8] 
@choice
@option [0000:1:8][1]
@var 变量 +1

@option [0000:1:8][2]
@var 变量 -1
@endchoice

[0000:1:9]

[end 0000:1]

[begin onexit]

[end onexit]

[end script]